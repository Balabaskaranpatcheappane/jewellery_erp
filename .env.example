# Copy to apps/api/.env and adjust for your local PostgreSQL 17 instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jewelry_erp?schema=public"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# API server
API_PORT=3000
API_CORS_ORIGIN="http://localhost:5173"

# Seed admin (used by prisma seed script)
SEED_ADMIN_EMAIL="admin@jewelry.local"
SEED_ADMIN_PASSWORD="admin123"
