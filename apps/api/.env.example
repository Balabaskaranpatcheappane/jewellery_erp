DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jewelry_erp?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
API_PORT=3000
# Comma-separated allowed origins (Vite dev + packaged localhost server)
API_CORS_ORIGIN="http://localhost:5173,http://localhost:4180"

# WebAuthn / Windows Hello (fingerprint login). RP_ID must be the hostname
# (no port/scheme); RP_ORIGIN is the comma-separated list of full origins.
RP_NAME="Jewelry ERP"
RP_ID="localhost"
RP_ORIGIN="http://localhost:5173,http://localhost:4180"

# Product licensing. Override the embedded vendor public key only if you
# regenerated the keypair (scripts/license-keygen.mjs --init). Use \n for newlines.
# LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
SEED_ADMIN_EMAIL="admin@jewelry.local"
SEED_ADMIN_PASSWORD="admin123"

# Directory where database backups (.dump) are written. Defaults to ./backups.
# Requires pg_dump / pg_restore on PATH (bundled with your PostgreSQL install).
# BACKUP_DIR="C:\\JewelryERP\\backups"
