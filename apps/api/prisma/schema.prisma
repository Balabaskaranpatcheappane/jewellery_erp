// Jewelry ERP — Prisma schema (skeleton).
// Phase 1 covers auth + the rate master. Domain modules (inventory-by-weight,
// customers, billing, making charges, old-gold exchange, karigar job-work,
// schemes, multi-branch) will be layered on in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum MetalType {
  GOLD
  SILVER
  PLATINUM
}

enum MakingChargeType {
  PER_GRAM
  FIXED
  PERCENT
}

enum ItemStatus {
  IN_STOCK
  RESERVED
  SOLD
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PAID
  CANCELLED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         UserRole     @default(CASHIER)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  metalRates   MetalRate[]
  invoices     Invoice[]

  @@map("users")
}

/// Daily precious-metal rates. The active rate for a given metal+purity is the
/// most recent row by effectiveDate. Historical rows are retained for audit and
/// for re-pricing old invoices.
model MetalRate {
  id            String    @id @default(cuid())
  metal         MetalType
  purity        String
  ratePerGram   Decimal   @db.Decimal(12, 3)
  effectiveDate DateTime  @db.Date
  createdBy     User?     @relation(fields: [createdById], references: [id])
  createdById   String?
  createdAt     DateTime  @default(now())

  @@unique([metal, purity, effectiveDate])
  @@index([metal, purity, effectiveDate])
  @@map("metal_rates")
}

/// A retail customer. Phone is the natural unique key for walk-in jewelry
/// shops; GSTIN is optional (only for B2B / tax invoices).
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  gstin     String?
  address   String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoices  Invoice[]

  @@index([name])
  @@map("customers")
}

/// Product grouping (Rings, Chains, Bangles, …) carrying GST HSN code and
/// default making-charge / wastage settings that new items inherit.
model ProductCategory {
  id                    String           @id @default(cuid())
  name                  String
  code                  String           @unique
  hsnCode               String?
  defaultMakingType     MakingChargeType @default(PER_GRAM)
  defaultMakingRate     Decimal          @default(0) @db.Decimal(12, 3)
  defaultWastagePercent Decimal          @default(0) @db.Decimal(6, 3)
  createdAt             DateTime         @default(now())
  updatedAt            DateTime          @updatedAt
  items                 Item[]

  @@map("product_categories")
}

/// A physical stock item / piece. Weights are in grams; net weight is gross
/// minus stone weight and is stored so billing never has to recompute it.
model Item {
  id              String           @id @default(cuid())
  sku             String           @unique
  name            String
  category        ProductCategory  @relation(fields: [categoryId], references: [id])
  categoryId      String
  metal           MetalType
  purity          String
  grossWeightGram Decimal          @db.Decimal(12, 3)
  stoneWeightGram Decimal          @default(0) @db.Decimal(12, 3)
  netWeightGram   Decimal          @db.Decimal(12, 3)
  makingType      MakingChargeType
  makingRate      Decimal          @db.Decimal(12, 3)
  wastagePercent  Decimal          @default(0) @db.Decimal(6, 3)
  huid            String?
  quantity        Int              @default(1)
  status          ItemStatus       @default(IN_STOCK)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  invoiceLines    InvoiceLine[]

  @@index([categoryId])
  @@index([status])
  @@index([metal, purity])
  @@map("items")
}

/// A sale invoice. Totals are computed server-side from the shared billing
/// engine and persisted so the invoice is a faithful historical record even if
/// rates or making charges change later.
model Invoice {
  id           String        @id @default(cuid())
  invoiceNo    String        @unique
  customer     Customer      @relation(fields: [customerId], references: [id])
  customerId   String
  invoiceDate  DateTime      @db.Date
  status       InvoiceStatus @default(FINALIZED)
  subtotal     Decimal       @db.Decimal(14, 2)
  cgstPercent  Decimal       @db.Decimal(6, 3)
  sgstPercent  Decimal       @db.Decimal(6, 3)
  cgst         Decimal       @db.Decimal(14, 2)
  sgst         Decimal       @db.Decimal(14, 2)
  oldGoldValue Decimal       @default(0) @db.Decimal(14, 2)
  roundOff     Decimal       @default(0) @db.Decimal(8, 2)
  grandTotal   Decimal       @db.Decimal(14, 2)
  notes        String?
  createdBy    User?         @relation(fields: [createdById], references: [id])
  createdById  String?
  createdAt    DateTime      @default(now())
  lines        InvoiceLine[]
  oldGoldLines OldGoldLine[]

  @@index([customerId])
  @@index([invoiceDate])
  @@map("invoices")
}

model InvoiceLine {
  id             String           @id @default(cuid())
  invoice        Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  item           Item?            @relation(fields: [itemId], references: [id])
  itemId         String?
  description    String
  metal          MetalType
  purity         String
  netWeightGram  Decimal          @db.Decimal(12, 3)
  ratePerGram    Decimal          @db.Decimal(12, 3)
  makingType     MakingChargeType
  makingRate     Decimal          @db.Decimal(12, 3)
  wastagePercent Decimal          @db.Decimal(6, 3)
  quantity       Int              @default(1)
  metalValue     Decimal          @db.Decimal(14, 2)
  makingAmount   Decimal          @db.Decimal(14, 2)
  wastageAmount  Decimal          @db.Decimal(14, 2)
  lineTotal      Decimal          @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("invoice_lines")
}

/// Old-gold / exchange taken against a sale; its value is deducted from the
/// invoice grand total.
model OldGoldLine {
  id               String    @id @default(cuid())
  invoice          Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId        String
  description      String
  metal            MetalType
  grossWeightGram  Decimal   @db.Decimal(12, 3)
  deductionPercent Decimal   @db.Decimal(6, 3)
  ratePerGram      Decimal   @db.Decimal(12, 3)
  value            Decimal   @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("old_gold_lines")
}
